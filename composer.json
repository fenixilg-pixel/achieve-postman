{
    "name": "fenixilg-pixel/achieve-postman",
    "description": "Sending templated emails to users upon receiving an achievement.",
    "type": "symfony-bundle",
    "version": "v0.0.1",
    "keywords": ["symfony","symfony-bundle"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ilgiz Nigamatzyanov",
            "email": "fenixilg@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "7.3.*",
        "symfony/mailer": "7.3.*",
        "symfony/twig-bundle": "7.3.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "bundle-class": "AchievePostman\\AchievePostman",
            "require": "7.3.*"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:fenixilg-pixel/achieve-postman.git"
        }
    ]
}
